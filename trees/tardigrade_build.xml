<root main_tree="MainTree" BTPY_FORMAT="1">
    <BehaviorTree ID="MainTree">
        <SequenceNode>
            <GetTilePos>
                <InputPort local="tile" bb="build_goal" />
                <OutputPort local="pos" bb="goal_pos" />
            </GetTilePos>
            <PlanPath>
                <InputPort local="self" bb="self" />
                <InputPort local="goal" bb="goal_pos" />
                <OutputPort local="path" bb="path" />
            </PlanPath>
            <MoveAlongPath>
                <InputPort local="path" bb="path" />
                <InputPort local="action_status" bb="action_status" />
                <OutputPort local="action_status" bb="action_status" />
            </MoveAlongPath>
            <!-- <Build /> -->
        </SequenceNode>
    </BehaviorTree>
</root>